import inspect
from .param import Param as Param
from .utility import name_with_prefix as name_with_prefix, type_name as type_name
from typing import Any

class ParamList:
    return_type: Param | None
    def __init__(self, params: list[Param] | None = None) -> None: ...
    def append(self, param: Param) -> ParamList: ...
    def add_return_type(self, t: Any) -> ParamList: ...
    def as_fix_method(self, name: str) -> str: ...
    def params(self) -> list[Param]: ...
    def param_keys(self) -> dict[str, Param]: ...
    def as_param_str(self, method_name: str | None = None) -> str: ...
    def __contains__(self, key: str) -> bool: ...
    def get(self, key: str) -> Param: ...
    def get_next_positional(self) -> Param | None: ...
    def get_remaining_positional(self) -> Param | None: ...
    def get_kwargs(self) -> tuple[dict[str, Param], Param | None]: ...
    def remaining(self) -> list[Param]: ...

def get_params(method) -> ParamList: ...
def get_params_from_signature(signature: inspect.Signature) -> ParamList: ...
